# Google AI Studio / Gemini API key. Required for the planning LLM.
GOOGLE_API_KEY=

# Planning model. gemini-2.0-flash was shut down; this PoC uses Gemini 2.5 Flash.
GEMINI_MODEL=gemini-2.5-flash

# Local Hugging Face embedding model (EmbeddingGemma).
EMBEDDING_MODEL=google/embeddinggemma-300m

# Approximate USD per 1,000,000 tokens for cost metrics.
# Gemini 2.5 Flash paid-tier text rates (input $0.30, output $2.50).
GEMINI_INPUT_USD_PER_1M_TOKENS=0.30
GEMINI_OUTPUT_USD_PER_1M_TOKENS=2.50
