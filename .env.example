# Google AI Studio / Gemini API key. Required for the planning LLM.
GOOGLE_API_KEY=

# Planning model. Locked for this PoC.
GEMINI_MODEL=gemini-2.0-flash

# Local Hugging Face embedding model (EmbeddingGemma).
EMBEDDING_MODEL=google/embeddinggemma-300m

# Approximate USD per 1,000,000 tokens for cost metrics.
# Gemini 2.0 Flash paid-tier text rates.
GEMINI_INPUT_USD_PER_1M_TOKENS=0.10
GEMINI_OUTPUT_USD_PER_1M_TOKENS=0.40
